<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Canteen Management System - Rajalakshmi Engineering College</title>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<!-- FontAwesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fontawesome/6.4.0/css/all.min.css">
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?
family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;
600;700&display=swap" rel="stylesheet">
<script>
tailwind.config = {
theme: {
extend: {
fontFamily: {
sans: ['Plus Jakarta Sans', 'sans-serif'],
mono: ['JetBrains Mono', 'monospace'],
},
colors: {
cyber: {
50: '#ecfeff',
400: '#22d3ee',
500: '#06b6d4',
600: '#0891b2',
700: '#0e7490',
900: '#164e63',
},
neon: {
emerald: '#10b981',
amber: '#f59e0b',
rose: '#f43f5e',
violet: '#8b5cf6'
},
dark: {
950: '#060913',
900: '#0b1120',
850: '#0f172a',
800: '#1e293b',
700: '#334155'
}
}
}
}
}
</script>
<style>
.custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
.custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); border-radius:
8px; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(6, 182, 212, 0.4); borderradius: 8px; }
.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(34, 211, 238, 0.7); }
.code-block { font-family: 'JetBrains Mono', monospace; background: #060913; color:
#38bdf8; }
.glass-panel {
background: rgba(15, 23, 42, 0.75);
backdrop-filter: blur(16px);
-webkit-backdrop-filter: blur(16px);
border: 1px solid rgba(255, 255, 255, 0.08);
}
.glass-card {
background: rgba(30, 41, 59, 0.5);
backdrop-filter: blur(12px);
border: 1px solid rgba(255, 255, 255, 0.06);
}
.glow-cyber {
box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.3);
}
.glow-emerald {
box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.3);
}
.btn-futuristic {
transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
position: relative;
overflow: hidden;
}
.btn-futuristic::after {
content: '';
position: absolute;
top: -50%;
left: -50%;
width: 200%;
height: 200%;
background: linear-gradient(60deg, transparent, rgba(255, 255, 255, 0.15), transparent);
transform: rotate(30deg);
transition: 0.5s;
opacity: 0;
}
.btn-futuristic:hover::after {
opacity: 1;
left: 100%;
}
</style>
</head>
<body class="h-full flex flex-col font-sans text-slate-200 bg-dark-950 antialiased
selection:bg-cyber-500 selection:text-white">
<!-- TOP HEADER / BRANDING BAR -->
<header class="glass-panel sticky top-0 z-40 border-b border-white/10 shadow-2xl">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
<div class="flex items-center space-x-3.5 cursor-pointer group" onclick="navigateTo('login')">
<div class="bg-gradient-to-tr from-cyber-600 via-cyber-500 to-indigo-500 p-3 rounded-2xl
shadow-lg shadow-cyber-500/30 text-white flex items-center justify-center grouphover:scale-105 transition-transform">
<i class="fa-solid fa-bolt text-lg"></i>
</div>
<div>
<div class="flex items-center space-x-2">
<span class="text-[10px] uppercase tracking-widest font-extrabold text-cyber-400 bg-cyber500/10 px-2.5 py-0.5 rounded-full border border-cyber-500/30">REC CANTEEN OS
v3.0</span>
</div>
<h1 class="text-base font-extrabold tracking-wide text-white flex items-center gap-2 mt-0.5">
<span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-slate400">Canteen Management System</span>
</h1>
</div>
</div>
<!-- RIGHT HEADER USER SESSION BADGE -->
<div class="flex items-center space-x-3">
<div id="session-header-info" class="hidden items-center space-x-3 bg-dark-900/90 px-4 py2 rounded-2xl border border-white/10 text-xs shadow-inner">
<div class="flex items-center space-x-2.5">
<div class="w-6 h-6 rounded-full bg-cyber-500/20 text-cyber-400 flex items-center justifycenter font-bold text-[10px] border border-cyber-500/40">
<i class="fa-solid fa-user"></i>
</div>
<span id="session-user-name" class="font-bold text-slate-100 tracking-wide">User</span>
</div>
<button onclick="logoutSession()" class="text-rose-400 hover:text-rose-300 font-bold
transition-colors pl-3 border-l border-slate-700/80 text-[11px] flex items-center gap-1.5
hover:scale-105">
<i class="fa-solid fa-power-off text-rose-400"></i>
<span class="hidden sm:inline">Logout</span>
</button>
</div>
</div>
</div>
</header>
<!-- MAIN APP WRAPPER -->
<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col">
<!-- PAGE 1: LOGIN PORTAL -->
<div id="page-login" class="flex-1 flex items-center justify-center py-12">
<div class="max-w-md w-full glass-panel rounded-3xl shadow-2xl border border-white/10 p-8
space-y-7 relative overflow-hidden">
<div class="absolute -top-24 -right-24 w-48 h-48 bg-cyber-500/10 rounded-full blur-3xl
pointer-events-none"></div>
<div class="text-center space-y-2 relative z-10">
<div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr
from-cyber-600 to-indigo-600 text-white text-2xl shadow-xl shadow-cyber-500/20 mb-2
border border-white/20">
<i class="fa-solid fa-shield-halved"></i>
</div>
<h2 class="text-2xl font-extrabold text-white tracking-tight">Rajalakshmi Campus Desk</h2>
<p class="text-xs text-slate-400 font-medium">Select access level to proceed into system
workflow.</p>
</div>
<!-- PORTAL SELECTOR TABS -->
<div class="flex bg-dark-950 p-1.5 rounded-2xl border border-white/10 relative z-10">
<button onclick="switchLoginTab('student')" id="login-tab-student"
class="flex-1 py-3 rounded-xl text-xs font-bold transition-all bg-gradient-to-r from-cyber-600
to-cyber-500 text-white shadow-lg shadow-cyber-500/20 flex items-center justify-center
space-x-2">
<i class="fa-solid fa-user-graduate"></i>
<span>Student Portal</span>
</button>
<button onclick="switchLoginTab('management')" id="login-tab-management"
class="flex-1 py-3 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white
flex items-center justify-center space-x-2">
<i class="fa-solid fa-user-gear"></i>
<span>Staff / Desk</span>
</button>
</div>
<!-- STUDENT LOGIN FORM -->
<form id="form-login-student" onsubmit="handleStudentLogin(event)" class="space-y-4 pt-1
relative z-10">
<div id="student-login-error" class="hidden p-3.5 bg-rose-500/10 border border-rose500/30 rounded-2xl text-rose-400 text-xs text-center font-bold items-center justify-center
gap-2">
<i class="fa-solid fa-circle-exclamation text-rose-400"></i>
<span id="student-login-error-msg">Invalid login credentials.</span>
</div>
<div class="space-y-2">
<label class="block text-[11px] font-bold text-cyber-400 uppercase tracking-widest">Student
Institutional Email</label>
<div class="relative">
<i class="fa-solid fa-envelope absolute left-4 top-3.5 text-slate-500 text-sm"></i>
<input type="email" id="student-login-email" required placeholder="Enter student email"
class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-dark-900 border border-white/10
focus:border-cyber-500 focus:ring-2 focus:ring-cyber-500/30 outline-none text-sm fontsemibold text-white placeholder-slate-600 transition-all">
</div>
</div>
<button type="submit" class="btn-futuristic w-full bg-gradient-to-r from-cyber-600 viacyber-500 to-indigo-600 hover:from-cyber-500 hover:to-indigo-500 text-white fontextrabold py-4 px-4 rounded-2xl shadow-xl shadow-cyber-500/25 transition-all text-sm flex
items-center justify-center space-x-2 active:scale-95 border border-white/20">
<span>Authenticate Student</span>
<i class="fa-solid fa-chevron-right text-xs"></i>
</button>
</form>
<!-- MANAGEMENT LOGIN FORM -->
<form id="form-login-management" onsubmit="handleManagementLogin(event)"
class="space-y-4 pt-1 hidden relative z-10">
<div class="space-y-2">
<label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest">Staff
Username</label>
<div class="relative">
<i class="fa-solid fa-user-lock absolute left-4 top-3.5 text-slate-500 text-sm"></i>
<input type="text" id="mgmt-username" value="admin" required placeholder="Username"
class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-dark-900 border border-white/10
focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 outline-none text-sm fontsemibold text-white transition-all">
</div>
</div>
<div class="space-y-2">
<label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest">Security
Access PIN</label>
<div class="relative">
<i class="fa-solid fa-key absolute left-4 top-3.5 text-slate-500 text-sm"></i>
<input type="password" id="mgmt-password" value="1234" required placeholder="PIN
(default: 1234)"
class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-dark-900 border border-white/10
focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 outline-none text-sm fontsemibold text-white transition-all">
</div>
</div>
<button type="submit" class="btn-futuristic w-full bg-gradient-to-r from-slate-800 via-slate700 to-slate-900 hover:from-slate-700 hover:to-slate-800 text-white font-extrabold py-4 px4 rounded-2xl shadow-xl transition-all text-sm flex items-center justify-center space-x-2
active:scale-95 border border-white/10">
<span>Access Management Desk</span>
<i class="fa-solid fa-lock text-xs"></i>
</button>
</form>
</div>
</div>
<!-- PAGE 2: STUDENT MENU & CART ORDERING -->
<div id="page-student-menu" class="space-y-6 hidden flex-1 flex flex-col">
<!-- PAGE HEADER BAR -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between glass-panel px-6 py-4
rounded-3xl shadow-xl gap-4">
<div class="flex items-center space-x-3">
<div class="w-11 h-11 rounded-2xl bg-cyber-500/10 border border-cyber-500/30 text-cyber400 flex items-center justify-center font-bold shadow-inner">
<i class="fa-solid fa-utensils text-lg"></i>
</div>
<div>
<h2 class="text-base font-extrabold text-white tracking-wide">Interactive Food
Selection</h2>
<p class="text-xs text-slate-400 font-medium">Add items, review stock limits, and generate a
bill for cash counter payment.</p>
</div>
</div>
<div class="flex items-center space-x-2 bg-dark-950/80 p-1.5 rounded-2xl border borderwhite/10">
<button onclick="navigateTo('student-menu')" class="btn-futuristic px-4 py-2.5 rounded-xl
text-xs font-extrabold transition-all bg-gradient-to-r from-cyber-600 to-cyber-500 text-white
shadow-md shadow-cyber-500/20 flex items-center space-x-2">
<i class="fa-solid fa-border-all"></i>
<span>Menu Catalog</span>
</button>
<button onclick="navigateTo('student-history')" class="btn-futuristic px-4 py-2.5 rounded-xl
text-xs font-extrabold transition-all text-slate-400 hover:text-white flex items-center space-x2">
<i class="fa-solid fa-receipt"></i>
<span>My History</span>
</button>
</div>
</div>
<!-- MAIN MENU & CART GRID -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1">
<!-- MENU LISTINGS -->
<div class="lg:col-span-8 space-y-4">
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 glass-panel p-4
rounded-3xl">
<div class="flex items-center space-x-2 overflow-x-auto custom-scrollbar pb-1 sm:pb-0"
id="student-category-filters"></div>
<span id="student-menu-count" class="text-xs font-mono font-bold text-cyber-400 bgcyber-500/10 border border-cyber-500/20 px-3.5 py-1 rounded-full whitespace-nowrap">0
Items</span>
</div>
<div id="student-menu-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
</div>
<!-- CART COLUMN -->
<div class="lg:col-span-4">
<div class="glass-panel rounded-3xl shadow-xl p-5 sticky top-24 flex flex-col max-h-[620px]
border border-white/10">
<div class="flex items-center justify-between pb-3.5 border-b border-white/10">
<div class="flex items-center space-x-2">
<i class="fa-solid fa-basket-shopping text-cyber-400 text-base"></i>
<h3 class="font-extrabold text-white text-sm tracking-wide">Selected Items</h3>
</div>
<button onclick="clearStudentCart()" class="text-xs text-rose-400 font-bold hover:text-rose300 transition-colors">Clear Cart</button>
</div>
<!-- CART LIST -->
<div id="student-cart-items" class="flex-1 overflow-y-auto py-3 space-y-3 custom-scrollbar">
</div>
<!-- CART FOOTER -->
<div class="pt-4 border-t border-white/10 space-y-3">
<div class="flex justify-between text-xs text-slate-400 font-medium">
<span>Subtotal</span>
<span id="student-cart-subtotal" class="font-mono font-bold text-slate-200">₹ 0.00</span>
</div>
<div class="flex justify-between text-white font-extrabold text-base border-t borderwhite/10 pt-2.5">
<span>Total Amount</span>
<span id="student-cart-total" class="font-mono text-cyber-400 text-xl font-bold">₹
0.00</span>
</div>
<button id="btn-place-order" onclick="placeStudentOrder()" disabled
class="btn-futuristic w-full bg-gradient-to-r from-cyber-600 via-cyber-500 to-indigo-600
hover:from-cyber-500 hover:to-indigo-500 text-white font-extrabold py-4 px-4 rounded-2xl
shadow-xl shadow-cyber-500/25 transition-all disabled:opacity-40 text-sm flex items-center
justify-center space-x-2 border border-white/20 active:scale-95">
<i class="fa-solid fa-file-invoice"></i>
<span>Generate Bill Number</span>
</button>
</div>
</div>
</div>
</div>
</div>
<!-- PAGE 3: STUDENT ORDER HISTORY -->
<div id="page-student-history" class="space-y-6 hidden flex-1 flex flex-col">
<div class="flex flex-col sm:flex-row sm:items-center justify-between glass-panel px-6 py-4
rounded-3xl shadow-xl gap-4">
<div class="flex items-center space-x-3">
<div class="w-11 h-11 rounded-2xl bg-cyber-500/10 border border-cyber-500/30 text-cyber400 flex items-center justify-center font-bold shadow-inner">
<i class="fa-solid fa-clock-rotate-left text-lg"></i>
</div>
<div>
<h2 class="text-base font-extrabold text-white tracking-wide">My Order Bills & Receipts</h2>
<p class="text-xs text-slate-400 font-medium">View live payment status and transaction
confirmations.</p>
</div>
</div>
<div class="flex items-center space-x-2 bg-dark-950/80 p-1.5 rounded-2xl border borderwhite/10">
<button onclick="navigateTo('student-menu')" class="btn-futuristic px-4 py-2.5 rounded-xl
text-xs font-extrabold transition-all text-slate-400 hover:text-white flex items-center space-x2">
<i class="fa-solid fa-border-all"></i>
<span>Menu Catalog</span>
</button>
<button onclick="navigateTo('student-history')" class="btn-futuristic px-4 py-2.5 rounded-xl
text-xs font-extrabold transition-all bg-gradient-to-r from-cyber-600 to-cyber-500 text-white
shadow-md shadow-cyber-500/20 flex items-center space-x-2">
<i class="fa-solid fa-receipt"></i>
<span>My History</span>
</button>
</div>
</div>
<div class="glass-panel rounded-3xl shadow-xl p-6 space-y-4">
<div id="student-history-container" class="space-y-4"></div>
</div>
</div>
<!-- PAGE 4: MANAGEMENT DESK & INVENTORY -->
<div id="page-management" class="space-y-6 hidden flex-1 flex flex-col">
<div class="flex flex-col sm:flex-row sm:items-center justify-between glass-panel px-6 py-4
rounded-3xl shadow-xl gap-4">
<div class="flex items-center space-x-3">
<div class="w-11 h-11 rounded-2xl bg-indigo-500/20 border border-indigo-500/30 textindigo-400 flex items-center justify-center font-bold shadow-inner">
<i class="fa-solid fa-cash-register text-lg"></i>
</div>
<div>
<h2 class="text-base font-extrabold text-white tracking-wide">Canteen Cash Counter &
Control</h2>
<p class="text-xs text-slate-400 font-medium">Verify bill numbers, collect liquid cash, and
update inventory stock.</p>
</div>
</div>
<div class="flex items-center space-x-2 bg-dark-950/80 p-1.5 rounded-2xl border borderwhite/10">
<button onclick="switchManagementTab('cash')" id="mgmt-tab-cash" class="btn-futuristic
px-4 py-2.5 rounded-xl text-xs font-extrabold transition-all bg-gradient-to-r from-indigo-600
to-cyber-600 text-white shadow-md flex items-center space-x-2">
<i class="fa-solid fa-cash-register"></i>
<span>Cash Desk</span>
</button>
<button onclick="switchManagementTab('stock')" id="mgmt-tab-stock" class="btn-futuristic
px-4 py-2.5 rounded-xl text-xs font-extrabold transition-all text-slate-400 hover:text-white
flex items-center space-x-2">
<i class="fa-solid fa-boxes-stacked"></i>
<span>Stock Management</span>
</button>
<button onclick="navigateTo('code-viewer')" class="btn-futuristic px-4 py-2.5 rounded-xl
text-xs font-extrabold transition-all text-cyber-400 hover:text-cyber-300 flex items-center
space-x-2">
<i class="fa-solid fa-code"></i>
<span>Java/DBMS Code</span>
</button>
</div>
</div>
<!-- CASH DESK TAB -->
<div id="mgmt-section-cash" class="space-y-6">
<div class="grid grid-cols-1 md:grid-cols-12 gap-6">
<div class="md:col-span-7 glass-panel p-6 rounded-3xl shadow-xl space-y-4">
<h3 class="font-extrabold text-white text-sm flex items-center gap-2 tracking-wide">
<i class="fa-solid fa-magnifying-glass text-cyber-400"></i>
<span>Search Bill ID for Liquid Cash Collection</span>
</h3>
<form onsubmit="handleMgmtBillSearch(event)" class="flex gap-2.5">
<input type="number" id="mgmt-search-input" placeholder="Enter Bill No (e.g. 101)"
required
class="w-full px-4 py-3.5 rounded-2xl bg-dark-900 border border-white/10 focus:bordercyber-500 outline-none font-mono text-sm font-semibold text-white placeholder-slate500">
<button type="submit" class="btn-futuristic bg-gradient-to-r from-cyber-600 to-indigo-600
hover:from-cyber-500 hover:to-indigo-500 text-white font-extrabold px-6 py-3.5 rounded-2xl
text-xs transition-all shadow-lg shadow-cyber-500/20 whitespace-nowrap active:scale-95">
Lookup Bill
</button>
</form>
</div>
<div class="md:col-span-5 grid grid-cols-2 gap-4">
<div class="glass-panel p-5 rounded-3xl shadow-xl">
<span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest
block">Pending Cash Bills</span>
<h4 id="mgmt-stat-pending" class="text-3xl font-extrabold font-mono text-white mt1">0</h4>
</div>
<div class="glass-panel p-5 rounded-3xl shadow-xl">
<span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest block">Total
Cash Collected</span>
<h4 id="mgmt-stat-collected" class="text-3xl font-extrabold font-mono text-emerald-400
mt-1">₹ 0.00</h4>
</div>
</div>
</div>
<div id="mgmt-search-result-card" class="hidden p-6 rounded-3xl border transition-all">
</div>
<div class="glass-panel rounded-3xl shadow-xl overflow-hidden">
<div class="p-5 border-b border-white/10 font-extrabold text-sm text-white flex justify-
between items-center">
<span>Database Order Transactions</span>
<span class="text-xs text-slate-400 font-medium">Real-Time Records</span>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left text-xs text-slate-300">
<thead class="bg-dark-950 uppercase border-b border-white/10 font-bold text-[11px] textslate-400 tracking-wider">
<tr>
<th class="py-4 px-6">Bill ID</th>
<th class="py-4 px-6">Customer</th>
<th class="py-4 px-6">Order Breakdown</th>
<th class="py-4 px-6 text-right">Total Amount</th>
<th class="py-4 px-6 text-center">Status</th>
<th class="py-4 px-6 text-center">Action</th>
</tr>
</thead>
<tbody id="mgmt-orders-tbody" class="divide-y divide-white/5"></tbody>
</table>
</div>
</div>
</div>
<!-- STOCK MANAGEMENT TAB -->
<div id="mgmt-section-stock" class="space-y-6 hidden">
<div class="glass-panel rounded-3xl shadow-xl p-6 overflow-hidden space-y-4">
<div class="flex justify-between items-center">
<div>
<h3 class="font-extrabold text-white text-sm">Inventory & Menu Availability</h3>
<p class="text-xs text-slate-400">Increase stock units or verify available counts.</p>
</div>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left text-xs text-slate-300">
<thead class="bg-dark-950 uppercase border-b border-white/10 font-bold text-[11px] textslate-400 tracking-wider">
<tr>
<th class="py-4 px-6">Food Item</th>
<th class="py-4 px-6">Category</th>
<th class="py-4 px-6 text-right">Price (₹)</th>
<th class="py-4 px-6 text-center">Current Stock</th>
<th class="py-4 px-6 text-center">Availability Status</th>
<th class="py-4 px-6 text-center">Action</th>
</tr>
</thead>
<tbody id="mgmt-inventory-tbody" class="divide-y divide-white/5"></tbody>
</table>
</div>
</div>
</div>
</div>
<!-- PAGE 5: CODE VIEWER -->
<div id="page-code-viewer" class="space-y-6 hidden flex-1 flex flex-col">
<div class="flex items-center justify-between glass-panel p-6 rounded-3xl border borderwhite/10">
<div>
<span class="text-xs font-mono font-bold text-cyber-400 uppercase trackingwidest">Source Code Repository</span>
<h2 class="text-xl font-extrabold text-white mt-0.5">Java & DBMS Source Code</h2>
</div>
<button onclick="navigateTo('management')" class="btn-futuristic bg-dark-800 hover:bgdark-700 text-slate-200 px-5 py-2.5 rounded-2xl text-xs font-extrabold border borderwhite/10">
Return to Desk
</button>
</div>
<div class="glass-panel rounded-3xl shadow-xl overflow-hidden border border-white/10">
