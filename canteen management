package com.canteen.controller;
import com.canteen.dao.OrderDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import java.io.IOException;
@WebServlet("/payCash")
public class CashPaymentServlet extends HttpServlet {
protected void doPost(HttpServletRequest request, HttpServletResponse response) throws
ServletException, IOException {
int orderId = Integer.parseInt(request.getParameter("orderId"));
OrderDAO dao = new OrderDAO();
boolean success = dao.updateCashPaymentCompleted(orderId);
if (success) {
response.sendRedirect("paymentSuccess.jsp?orderId=" + orderId);
} else {
response.sendRedirect("payment.jsp?error=InvalidBillNo");
}
}
