<span class="font-mono font-bold text-cyber-400 text-base">Total: ₹
${o.totalAmount.toFixed(2)}</span>
</div>
${isPaid ? `
<div class="bg-emerald-500/10 border border-emerald-500/30 p-2.5 rounded-2xl textemerald-300 text-[11px] font-semibold flex items-center gap-2">
<i class="fa-solid fa-circle-check text-emerald-400"></i>
<span>Paid at Cash Counter Desk on ${o.paidAt || 'Counter Desk'}</span>
</div>
` : ''}
</div>
`;
}).join('');
}
function switchManagementTab(tab) {
document.getElementById('mgmt-tab-cash').className = tab === 'cash' ? "btn-futuristic px-4
py-2.5 rounded-xl text-xs font-extrabold transition-all bg-gradient-to-r from-indigo-600 tocyber-600 text-white shadow-md flex items-center space-x-2" : "btn-futuristic px-4 py-2.5
rounded-xl text-xs font-extrabold transition-all text-slate-400 hover:text-white flex itemscenter space-x-2";
document.getElementById('mgmt-tab-stock').className = tab === 'stock' ? "btn-futuristic
px-4 py-2.5 rounded-xl text-xs font-extrabold transition-all bg-gradient-to-r from-indigo-600
to-cyber-600 text-white shadow-md flex items-center space-x-2" : "btn-futuristic px-4 py-2.5
rounded-xl text-xs font-extrabold transition-all text-slate-400 hover:text-white flex itemscenter space-x-2";
if (tab === 'cash') {
document.getElementById('mgmt-section-cash').classList.remove('hidden');
document.getElementById('mgmt-section-stock').classList.add('hidden');
renderManagementOrdersTable();
updateManagementStats();
} else {
document.getElementById('mgmt-section-stock').classList.remove('hidden');
document.getElementById('mgmt-section-cash').classList.add('hidden');
renderManagementInventory();
}
}
function handleMgmtBillSearch(e) {
if (e && e.preventDefault) e.preventDefault();
const val = parseInt(document.getElementById('mgmt-search-input').value);
const order = ordersDatabase.find(o => o.orderId === val);
const card = document.getElementById('mgmt-search-result-card');
if (!order) {
card.classList.remove('hidden');
card.className = "p-4 bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs
text-center font-bold rounded-3xl";
card.innerHTML = "Bill ID Not Found in Database Records";
return;
}
card.classList.remove('hidden');
const isPaid = order.paymentStatus === 'PAID_CASH';
card.className = `p-6 rounded-3xl border text-xs space-y-3 ${isPaid ? 'bg-emerald-950/20
border-emerald-500/30' : 'bg-amber-500/10 border-amber-500/30'}`;
card.innerHTML = `
<div class="flex justify-between items-center font-extrabold text-white text-base">
<span>Bill #${order.orderId} - ${order.customerName}</span>
<span class="font-mono text-cyber-400">₹${order.totalAmount.toFixed(2)}</span>
</div>
<div class="text-slate-300 font-medium">Items: ${order.items.map(i => `${i.name}
(×${i.qty})`).join(', ')}</div>
${!isPaid ? `
<button onclick="mgmtConfirmCash(${order.orderId})" class="btn-futuristic bg-gradient-to-r
from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white fontextrabold px-5 py-2.5 rounded-2xl text-xs transition-all shadow-lg shadow-emerald-500/20
active:scale-95 border border-white/10">
Confirm Cash Payment Received
</button>
` : `<span class="text-emerald-400 font-bold block bg-emerald-500/10 border borderemerald-500/30 p-2.5 rounded-2xl text-center"><i class="fa-solid fa-circle-check mr-2">
</i>PAID CASH</span>`}
`;
}
function mgmtConfirmCash(billId) {
const order = ordersDatabase.find(o => o.orderId === billId);
if (order) {
order.paymentStatus = 'PAID_CASH';
order.paidAt = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ', ' + new
Date().toLocaleDateString();
saveToLocalStorage();
renderManagementOrdersTable();
updateManagementStats();
handleMgmtBillSearch(null);
}
}
function renderManagementOrdersTable() {
const tbody = document.getElementById('mgmt-orders-tbody');
tbody.innerHTML = ordersDatabase.map(o => {
const isPaid = o.paymentStatus === 'PAID_CASH';
return `
<tr class="hover:bg-white/5 border-b border-white/5 transition-colors">
<td class="py-4 px-6 font-mono font-bold text-cyber-400">#${o.orderId}</td>
<td class="py-4 px-6 font-semibold text-white">${o.customerName}</td>
<td class="py-4 px-6 text-slate-300">${o.items.map(i => `${i.name} (×${i.qty})`).join(', ')}</td>
<td class="py-4 px-6 text-right font-mono font-bold text-white">₹${o.totalAmount.toFixed(2)}
</td>
<td class="py-4 px-6 text-center font-bold ${isPaid ? 'text-emerald-400' : 'text-amber400'}">${o.paymentStatus}</td>
<td class="py-4 px-6 text-center">
${!isPaid ? `<button onclick="mgmtConfirmCash(${o.orderId})" class="btn-futuristic bggradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500
text-white font-extrabold px-3 py-1.5 rounded-xl text-[11px] shadow-sm border borderwhite/10">Mark Paid</button>` : `<span class="text-slate-500 fontmedium">Completed</span>`}
</td>
</tr>
`;
}).join('');
}
function updateManagementStats() {
const pending = ordersDatabase.filter(o => o.paymentStatus === 'PENDING_CASH').length;
const collected = ordersDatabase.filter(o => o.paymentStatus === 'PAID_CASH').reduce((sum,
o) => sum + o.totalAmount, 0);
document.getElementById('mgmt-stat-pending').innerText = pending.toString();
document.getElementById('mgmt-stat-collected').innerText = `₹ ${collected.toFixed(2)}`;
}
function renderManagementInventory() {
document.getElementById('mgmt-inventory-tbody').innerHTML = menuDatabase.map(item
=> `
<tr class="hover:bg-white/5 border-b border-white/5 transition-colors">
<td class="py-4 px-6 font-extrabold text-white">${item.name}</td>
<td class="py-4 px-6 text-slate-300">${item.category}</td>
<td class="py-4 px-6 text-right font-mono font-bold text-cyber-400">₹
${item.price.toFixed(2)}</td>
<td class="py-4 px-6 text-center font-mono font-bold text-white">${item.stock}</td>
<td class="py-4 px-6 text-center">
<span class="px-3 py-1 rounded-full text-[10px] font-bold ${item.stock > 0 ? 'bg-emerald500/20 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-400
border border-rose-500/30'}">
${item.stock > 0 ? 'AVAILABLE' : 'OUT OF STOCK'}
</span>
</td>
<td class="py-4 px-6 text-center">
<button onclick="addStock(${item.id})" class="btn-futuristic bg-dark-800 hover:bg-dark-700
text-slate-200 font-bold px-3 py-1.5 rounded-xl text-xs border border-white/10 active:scale90">+5 Stock</button>
</td>
</tr>
`).join('');
}
function addStock(foodId) {
const item = menuDatabase.find(i => i.id === foodId);
if (item) {
item.stock += 5;
saveToLocalStorage();
renderManagementInventory();
}
}
function switchCodeFile(fileKey) {
['db', 'models', 'servlets'].forEach(key => {
document.getElementById(`code-file-${key}`).classList.add('hidden');
document.getElementById(`code-tab-${key}`).className = "px-6 py-4 text-xs font-bold textslate-400 hover:text-white";
});
document.getElementById(`code-file-${fileKey}`).classList.remove('hidden');
document.getElementById(`code-tab-${fileKey}`).className = "px-6 py-4 text-xs font-bold
border-b-2 border-cyber-400 text-cyber-400 bg-dark-900";
}
</script>
</body>
</html>
