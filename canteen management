function updateStudentCart(foodId, change) {
const item = menuDatabase.find(i => i.id === foodId);
const current = studentCart[foodId] || 0;
const updated = current + change;
if (updated > item.stock) return alert(`Stock limit reached (${item.stock})`);
if (updated <= 0) delete studentCart[foodId];
else studentCart[foodId] = updated;
renderStudentMenu();
renderStudentCart();
}
function clearStudentCart() {
studentCart = {};
renderStudentMenu();
renderStudentCart();
}
function renderStudentCart() {
const container = document.getElementById('student-cart-items');
const entries = Object.entries(studentCart);
if (entries.length === 0) {
container.innerHTML = `<div class="text-center py-12 text-slate-500 text-xs fontmedium">Cart is empty. Select items from menu.</div>`;
document.getElementById('student-cart-subtotal').innerText = '₹ 0.00';
document.getElementById('student-cart-total').innerText = '₹ 0.00';
document.getElementById('btn-place-order').disabled = true;
return;
}
let total = 0;
container.innerHTML = entries.map(([idStr, qty]) => {
const item = menuDatabase.find(i => i.id === parseInt(idStr));
const subtotal = item.price * qty;
total += subtotal;
return `
<div class="flex items-center justify-between p-3 bg-dark-900/80 rounded-2xl border
border-white/5 text-xs">
<div>
<h4 class="font-bold text-white">${item.name}</h4>
<span class="text-[10px] text-slate-400">₹${item.price} × ${qty}</span>
</div>
<span class="font-mono font-bold text-cyber-400">₹${subtotal.toFixed(2)}</span>
</div>
`;
}).join('');
document.getElementById('student-cart-subtotal').innerText = `₹ ${total.toFixed(2)}`;
document.getElementById('student-cart-total').innerText = `₹ ${total.toFixed(2)}`;
document.getElementById('btn-place-order').disabled = false;
}
function placeStudentOrder() {
const entries = Object.entries(studentCart);
let totalAmount = 0;
const orderItems = [];
for (let [idStr, qty] of entries) {
const item = menuDatabase.find(i => i.id === parseInt(idStr));
item.stock -= qty;
const subtotal = item.price * qty;
totalAmount += subtotal;
orderItems.push({ foodId: item.id, name: item.name, qty: qty, unitPrice: item.price, subtotal:
subtotal });
}
const newOrder = {
orderId: autoBillSeq++,
customerName: currentUser.name,
customerEmail: currentUser.email || 'N/A',
dateTime: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ', ' + new
Date().toLocaleDateString(),
items: orderItems,
totalAmount: totalAmount,
paymentStatus: 'PENDING_CASH',
paidAt: null
};
ordersDatabase.unshift(newOrder);
saveToLocalStorage();
studentCart = {};
renderStudentMenu();
renderStudentCart();
showBillReceiptModal(newOrder);
}
